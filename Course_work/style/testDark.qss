/* Общие стили для всех элементов */
* {
    font-family: "Segoe UI", "Noto Sans Mono CJK TC", sans-serif;
    border-radius: 4px;
    outline: none;
    transition: all 0.3s ease; /* Плавные анимации для всех элементов */
}

::selection {
    background-color: #555555; /* Темно-серый цвет фона при выделении */
    color: #ffffff; /* Белый цвет текста */
}

/* Изменение цвета выделения текста при отмене выделения */
::unselection {
    background-color: transparent; /* Без фона при отмене выделения */
    color: inherit; /* Сохраняет цвет текста по умолчанию */
}

/* Для элементов ввода текста (если это необходимо для QTextEdit или QLineEdit) */
QLineEdit::selection, QTextEdit::selection {
    background-color: #555555; /* Темно-серый фон при выделении */
    color: #ffffff; /* Белый цвет текста */
}
/* Темная тема */
QWidget {
    background-color: #2e2e2e;
    color: #ffffff;
}

/* Кнопки */
QPushButton {
    background-color: #444444;
    border: 1px solid #666666;
    color: #ffffff;
    padding: 6px 12px;
    transition: all 0.3s ease;
}

/* Ключевые кадры для анимации кнопки */
@keyframes buttonHoverAnimation {
    0% {
        background-color: #444444;
        transform: scale(1);
    }
    50% {
        background-color: #555555;
        transform: scale(1.1);
    }
    100% {
        background-color: #666666;
        transform: scale(1);
    }
}

QPushButton:hover {
    animation: buttonHoverAnimation 0.5s forwards;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3); /* Легкая тень при наведении */
}

QPushButton:pressed {
    background-color: #666666;
    border: 1px solid #888888;
}

QPushButton:focus {
    border: 2px solid #888888; /* Легкая серая рамка при фокусе */
}

/* Ввод текста и комбинированные элементы */
QLineEdit, QTextEdit, QComboBox {
    background-color: #444444;
    color: #ffffff;
    border: 1px solid #666666;
    padding: 4px;
    border-radius: 3px;
}

/* Анимация для текстового ввода */
@keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

QLineEdit, QTextEdit {
    animation: fadeIn 1s ease-in-out; /* Плавное появление элементов */
}

QTextEdit {
    background-color: #333333;
    min-height: 100px;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #888888; /* Легкая серая рамка при фокусе */
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1); /* Легкая тень при фокусе */
}

QComboBox {
    background-color: #333333;
    border: 1px solid #666666;
    padding: 6px;
    border-radius: 4px;
}

QComboBox:hover {
    border-color: #888888;
}

QComboBox::down-arrow {
    border: none;
    image: url(':/icons/down-arrow.svg');
}

QComboBox::drop-down {
    background-color: #444444;
}

/* Списки */
QListWidget {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #444444;
}

QListWidget::item:selected {
    background-color: #555555; /* Темно-серый фон при выделении */
    color: #ffffff;
}

/* Панель инструментов */
QWidget#ToolBar {
    background-color: #333333;
    border: 1px solid #666666;
    padding: 6px;
}

/* Площадка для прокрутки (ScrollArea) */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea::widget {
    background-color: #444444;
    border-radius: 4px;
    padding: 10px;
}

/* Эффекты на ScrollBar */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #555555;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #777777;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #888888;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
}

QScrollBar::add-line:vertical, QScrollBar::add-line:horizontal,
QScrollBar::sub-line:vertical, QScrollBar::sub-line:horizontal {
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::add-page:horizontal,
QScrollBar::sub-page:vertical, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Выделение текста */
QTextEdit:focus {
    border: 1px solid #888888; /* Легкая серая рамка при фокусе */
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1); /* Легкая тень при фокусе */
}

/* Меню */
QMenuBar {
    background-color: #333333;
    color: #ffffff;
}

QMenuBar::item {
    padding: 8px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #444444;
}

QMenu {
    background-color: #333333;
    border: 1px solid #555555;
}

QMenu::item:selected {
    background-color: #444444;
}

QMenu::item:hover {
    background-color: #555555;
}

/* Стиль для ToolButton */
QToolButton {
    background: none;
    border: none;
    padding: 4px;
    margin: 2px;
}

QToolButton:hover {
    background-color: #555555;
    border-radius: 4px;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
}

QToolButton:pressed {
    background-color: #666666;
}

QToolButton::menu-indicator {
    image: url(':/icons/arrow-down.svg');
}

/* Стиль для заголовков */
QComboBox#headingBox {
    background-color: #444444;
    color: #ffffff;
    border: 1px solid #666666;
    padding: 4px;
}

QComboBox#headingBox::item:selected {
    background-color: #555555; /* Темный фон при выделении */
}

/* Диалог выбора цвета (QColorDialog) */
QColorDialog {
    background-color: #2e2e2e;
    color: #ffffff;
    border-radius: 10px;
    padding: 5px;
}

QColorDialog QToolButton {
    background-color: #444444;
    border-radius: 5px;
    padding: 8px;
}

QColorDialog QToolButton:hover {
    background-color: #555555;
}

QColorDialog QToolButton:pressed {
    background-color: #666666;
}

/* Диалог ввода чисел (QInputDialog) */
QInputDialog {
    background-color: #333333;
    color: #ffffff;
    border-radius: 8px;
    padding: 10px;
}

QInputDialog QLineEdit {
    background-color: #444444;
    border: 1px solid #666666;
    border-radius: 5px;
    padding: 8px;
}

QInputDialog QPushButton {
    background-color: #444444;
    color: #ffffff;
    border-radius: 5px;
    padding: 10px;
}

QInputDialog QPushButton:hover {
    background-color: #555555;
}

QInputDialog QPushButton:pressed {
    background-color: #666666;
}

/* Стили для всей таблицы */
QTextTable {
    border: 1px solid #666666; /* Цвет и стиль рамки */
    border-radius: 4px;         /* Радиус скругления углов таблицы */
    background-color: #333333;  /* Цвет фона всей таблицы */
}

/* Стилизация ячеек таблицы */
QTextTableCell {
    border: 1px solid #555555;  /* Цвет рамки ячеек */
    padding: 8px;                /* Отступ внутри ячеек */
    background-color: #444444;  /* Цвет фона ячеек */
    color: #ffffff;             /* Цвет текста внутри ячеек */
}

/* Стилизация ячеек при наведении */
QTextTableCell:hover {
    background-color: #555555;  /* Цвет фона при наведении */
}

/* Стилизация текста в ячейках */
QTextBlock {
    color: #ffffff;             /* Цвет текста */
    font-size: 12px;            /* Размер шрифта текста */
    font-family: "Segoe UI", "Arial", sans-serif;  /* Шрифт текста */
}

/* Стилизация текста в заголовке таблицы */
QTextTable::header {
    background-color: #666666;  /* Цвет фона заголовков */
    color: #ffffff;             /* Цвет текста заголовков */
    font-weight: bold;          /* Жирный шрифт для заголовков */
    font-size: 14px;            /* Размер шрифта заголовков */
}

/* Стили для таблиц в QTextEdit с несколькими строками и столбцами */
QTextEdit {
    background-color: #333333;  /* Цвет фона QTextEdit */
    color: #ffffff;             /* Цвет текста QTextEdit */
}

