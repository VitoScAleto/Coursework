/* Основной фон */
QWidget {
    background-color: #2C2C2C;
    color: #E0E0E0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Заголовки */
QLabel {
    font-size: 14px;
    font-weight: bold;
    color: #E0E0E0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Кнопки */
QPushButton {
    background-color: #444444;
    border: 1px solid #555555;
    color: #E0E0E0;
    padding: 6px 16px;
    border-radius: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QPushButton:hover {
    background-color: #555555;
}

QPushButton:pressed {
    background-color: #666666;
}

/* Кнопки с иконками */
QPushButton::icon {
    margin-left: 10px;
}

/* Панель инструментов */
QToolBar {
    background-color: #333333;
    border: none;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Список страниц */
QListWidget {
    background-color: #3D3D3D;
    border: 1px solid #555555;
    color: #E0E0E0;
    padding: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QListWidget::item {
    padding: 5px;
}

QListWidget::item:selected {
    background-color: #555555;
}

/* Строка прокрутки */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #444444;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #666666;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #777777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background-color: #444444;
}

QScrollBar::add-line:hover:vertical, QScrollBar::sub-line:hover:vertical,
QScrollBar::add-line:hover:horizontal, QScrollBar::sub-line:hover:horizontal {
    background-color: #555555;
}

/* Ввод текста */
QTextEdit, QLineEdit {
    background-color: #3D3D3D;
    border: 1px solid #555555;
    color: #E0E0E0;
    padding: 6px;
    font-size: 14px;
    border-radius: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QTextEdit:focus, QLineEdit:focus {
    border: 1px solid #888888;
}

/* Комбо-боксы */
QComboBox {
    background-color: #444444;
    border: 1px solid #555555;
    color: #E0E0E0;
    padding: 6px;
    border-radius: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #3D3D3D;
    color: #E0E0E0;
    border: 1px solid #555555;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #555555;
}

/* Выравнивание текста */
QPushButton[objectName="alignLeft"] {
    background-color: #444444;
}

QPushButton[objectName="alignCenter"] {
    background-color: #444444;
}

QPushButton[objectName="alignRight"] {
    background-color: #444444;
}

QPushButton[objectName="alignJustify"] {
    background-color: #444444;
}

/* Вставка таблицы */
QPushButton[objectName="insertTable"] {
    background-color: #444444;
}

/* Цвет текста */
QPushButton[objectName="changeColor"] {
    background-color: #444444;
}

/* Цвет фона */
QPushButton[objectName="changeBgColor"] {
    background-color: #444444;
}

/* Выбор шрифта */
QComboBox#fontSizeBox {
    background-color: #444444;
    border: 1px solid #555555;
    color: #E0E0E0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QComboBox#headingBox {
    background-color: #444444;
    border: 1px solid #555555;
    color: #E0E0E0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QPushButton[objectName="clearFormatting"] {
    background-color: #444444;
}

/* Панель с вкладками */
QTabBar {
    background-color: #333333;
    color: #E0E0E0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QTabBar::tab {
    background-color: #444444;
    padding: 6px;
    border-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #555555;
}
QListWidget {
    background-color: #2D2D2D;
    border: none;
    color: #E0E0E0;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #444444;
}

QListWidget::item:selected {
    background-color: #444444;  /* Темный фон при выделении */
    color: #ffffff;  /* Белый цвет текста при выделении */
}

QListWidget::item:hover {
    background-color: #3A3A3A; /* Темно-серый фон при наведении */
    color: #ffffff;
}

