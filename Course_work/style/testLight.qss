/* Основной фон */
QWidget {
    background-color: #ECECEC;
    color: #333333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Заголовки */
QLabel {
    font-size: 14px;
    font-weight: bold;
    color: #333333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Кнопки */
QPushButton {
    background-color: #D1D1D1;
    border: 1px solid #B0B0B0;
    color: #333333;
    padding: 6px 16px;
    border-radius: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QPushButton:hover {
    background-color: #B8B8B8;
}

QPushButton:pressed {
    background-color: #A0A0A0;
}

/* Кнопки с иконками */
QPushButton::icon {
    margin-left: 10px;
}

/* Панель инструментов */
QToolBar {
    background-color: #D9D9D9;
    border: none;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Список страниц */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #B0B0B0;
    color: #333333;
    padding: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QListWidget::item {
    padding: 5px;
}

QListWidget::item:selected {
    background-color: #B8B8B8;
}

/* Строка прокрутки */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #D1D1D1;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #A0A0A0;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #888888;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background-color: #D1D1D1;
}

QScrollBar::add-line:hover:vertical, QScrollBar::sub-line:hover:vertical,
QScrollBar::add-line:hover:horizontal, QScrollBar::sub-line:hover:horizontal {
    background-color: #B0B0B0;
}

/* Ввод текста */
QTextEdit, QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #B0B0B0;
    color: #333333;
    padding: 6px;
    font-size: 14px;
    border-radius: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QTextEdit:focus, QLineEdit:focus {
    border: 1px solid #888888;
}

/* Комбо-боксы */
QComboBox {
    background-color: #F5F5F5;
    border: 1px solid #B0B0B0;
    color: #333333;
    padding: 6px;
    border-radius: 5px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #B0B0B0;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #B8B8B8;
}

/* Выравнивание текста */
QPushButton[objectName="alignLeft"] {
    background-color: #D1D1D1;
}

QPushButton[objectName="alignCenter"] {
    background-color: #D1D1D1;
}

QPushButton[objectName="alignRight"] {
    background-color: #D1D1D1;
}

QPushButton[objectName="alignJustify"] {
    background-color: #D1D1D1;
}

/* Вставка таблицы */
QPushButton[objectName="insertTable"] {
    background-color: #D1D1D1;
}

/* Цвет текста */
QPushButton[objectName="changeColor"] {
    background-color: #D1D1D1;
}

/* Цвет фона */
QPushButton[objectName="changeBgColor"] {
    background-color: #D1D1D1;
}

/* Выбор шрифта */
QComboBox#fontSizeBox {
    background-color: #F5F5F5;
    border: 1px solid #B0B0B0;
    color: #333333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QComboBox#headingBox {
    background-color: #F5F5F5;
    border: 1px solid #B0B0B0;
    color: #333333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QPushButton[objectName="clearFormatting"] {
    background-color: #D1D1D1;
}

/* Панель с вкладками */
QTabBar {
    background-color: #D9D9D9;
    color: #333333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

QTabBar::tab {
    background-color: #F5F5F5;
    padding: 6px;
    border-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #B8B8B8;
}
QListWidget {
    background-color: #ffffff;
    border: 1px solid #CCCCCC;
    color: #333333;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #DDDDDD;
}

QListWidget::item:selected {
    background-color: #E0E0E0;  /* Светлый фон при выделении */
    color: #000000;  /* Черный цвет текста при выделении */
}

QListWidget::item:hover {
    background-color: #F0F0F0; /* Светло-серый фон при наведении */
    color: #000000;
}
